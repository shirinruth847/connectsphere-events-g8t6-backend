PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Required: your own Atlas user (URL-encode the password). Server-only.
MONGODB_URI=mongodb+srv://<atlas-user>:<url-encoded-password>@spm.ldi4ulx.mongodb.net/?appName=SPM
MONGODB_DB_NAME=connectsphere_dev
# Venue booking requests (SPM-179): least-privilege role venue_calendar_writer,
# session pooler (port 5432), sslmode=verify-full&sslrootcert=<path to the Supabase CA
# certificate>; pg treats sslmode=require as verify-full, which needs that CA.
# Server-only; never TEST_DATABASE_URL.
VENUE_LOCK_DATABASE_URL=
# Required only by the synthetic-account provisioning script.
SEED_ACCOUNT_PASSWORD=
# Event completion job period in milliseconds (default 60000). 0 turns it off,
# for example on a machine that should not complete shared events.
EVENT_COMPLETION_INTERVAL_MS=
# Attendee event reminder job (SPM-158), in milliseconds. Default 300000 (5 min); 0 turns it off.
EVENT_REMINDER_INTERVAL_MS=
# Optional test-only privileged connection to the same isolated test database.
# Required for integration suites that create audit records. Never expose it
# to the browser or give audit-log DELETE rights to the runtime identity.
TEST_DATABASE_URL=
