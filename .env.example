PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Required: your own Atlas user (URL-encode the password). Server-only.
MONGODB_URI=mongodb+srv://<atlas-user>:<url-encoded-password>@spm.ldi4ulx.mongodb.net/?appName=SPM
MONGODB_DB_NAME=connectsphere_dev
# Required only by the synthetic-account provisioning script.
SEED_ACCOUNT_PASSWORD=
# Lead queue, assignment and reassignment routes. Shared development enables
# them: SPM-33's coordinator view needs assigned events. Unset or false = 404.
ENABLE_COORDINATOR_WORKFLOWS=true
# Optional test-only privileged connection to the same isolated test database.
# Required for integration suites that create audit records. Never expose it
# to the browser or give audit-log DELETE rights to the runtime identity.
TEST_DATABASE_URL=
