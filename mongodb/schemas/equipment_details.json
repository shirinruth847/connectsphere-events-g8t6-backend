      "specifications": { "bsonType": ["string", "null"], "maxLength": 2000 },
      "technicalNotes": { "bsonType": ["string", "null"], "maxLength": 2000 },
      "handlingNotes": { "bsonType": ["string", "null"], "maxLength": 2000 },
      "updatedAt": { "bsonType": "date" },
      "fixture": { "bsonType": "string", "maxLength": 64 }
